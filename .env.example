# Copy this file to .env and fill it in. Never commit .env.
GEMINI_API_KEY=your_api_key_here
# model that writes the script
GEMINI_TEXT_MODEL=gemini-2.5-flash
# text-to-speech model for the voice-over
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Optional
# REELSTUDIO_PROVIDER=fake        # offline demo: no Gemini calls at all
# REELSTUDIO_DATA_DIR=D:/reels    # keep projects outside OneDrive
# REELSTUDIO_PORT=5000
