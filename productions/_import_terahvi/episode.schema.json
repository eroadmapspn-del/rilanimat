{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/hindi-mystery-episode.schema.json",
  "title": "Hindi Mystery Episode",
  "type": "object",
  "required": [
    "episode_number",
    "episode_id",
    "title_hi",
    "target_duration_seconds",
    "narration_hi",
    "voiceover",
    "scenes",
    "audience_engagement",
    "continuity",
    "production"
  ],
  "properties": {
    "episode_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 180
    },
    "episode_id": {
      "type": "string",
      "pattern": "^EP-[0-9]{3}$"
    },
    "title_hi": {
      "type": "string",
      "minLength": 1
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 120
    },
    "narration_hi": {
      "type": "string",
      "minLength": 40
    },
    "narration_word_count": {
      "type": "integer",
      "minimum": 1
    },
    "voiceover": {
      "type": "object",
      "required": [
        "language",
        "voice_id",
        "audio_path",
        "word_timestamps_path",
        "status"
      ],
      "properties": {
        "language": {
          "const": "hi-IN"
        },
        "voice_id": {
          "type": "string"
        },
        "audio_path": {
          "type": "string"
        },
        "word_timestamps_path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "not_generated",
            "generated",
            "validated"
          ]
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "estimated_start_s",
          "estimated_end_s",
          "visual_prompt_hi",
          "voiceover_text",
          "asset_status"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "estimated_start_s": {
            "type": "number",
            "minimum": 0
          },
          "estimated_end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visual_prompt_hi": {
            "type": "string",
            "minLength": 10
          },
          "voiceover_text": {
            "type": "string"
          },
          "asset_status": {
            "enum": [
              "not_generated",
              "generated",
              "approved"
            ]
          }
        }
      }
    },
    "audience_engagement": {
      "type": "object",
      "required": [
        "question_hi",
        "placement",
        "canon_impact"
      ],
      "properties": {
        "question_hi": {
          "type": "string"
        },
        "placement": {
          "type": "string"
        },
        "canon_impact": {
          "const": "none"
        }
      }
    },
    "continuity": {
      "type": "object"
    },
    "production": {
      "type": "object"
    }
  }
}