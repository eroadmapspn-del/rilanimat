  "scenes": [
    {
      "text": "राजेश की ज़िंदगी में दस साल से सिर्फ़ दो पते थे। घर, और दफ़्तर।",
      "transition": "fade",
      "visual": {
        "prompt": "Rajesh slumped in his dark flat while an alarm rings. Vertical 9:16, dark teal and amber.",
        "file": null,
        "source": "react-art",
        "art": {
          "location": "home",
          "characters": [
            {
              "id": "RAJAT",
