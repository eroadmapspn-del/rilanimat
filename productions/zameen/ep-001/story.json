          "dim": 0.3
        }
      }
    },
    {
      "text": "यह भविष्यवाणी नहीं थी। पर ख़तरा असली था।",
      "transition": "fade",
      "visual": {
        "prompt": "Close on Aarav's face, jaw tight.",
        "file": null,
        "source": "react-art",
        "art": {
          "location": "office",
          "characters": [
            {
              "id": "AARAV",
              "mood": "worried",
              "action": "idle",
