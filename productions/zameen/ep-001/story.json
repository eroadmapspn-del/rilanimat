          "dim": 0.4
        }
      }
    },
    {
      "text": "वह फुसफुसाया, इस बार सिर्फ़ डिज़ाइन पास नहीं करना है। घर पहुँचना है।",
      "transition": "fade",
      "visual": {
        "prompt": "Aarav, head low, whispering.",
        "file": null,
        "source": "react-art",
        "art": {
          "location": "office",
