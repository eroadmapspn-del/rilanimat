        },
        "camera": "drift",
        "atmosphere": {
          "tint": "#0e2a33",
          "dim": 0.3
        }
      }
    },
    {
      "text": "स्क्रीन बुझ गई। उसकी नज़र बेटी की स्कूल वाली तस्वीर पर रुक गई।",
      "transition": "fade",
      "visual": {
