          ],
          "fog": 0.2,
          "dust": true,
          "view": "close"
        },
        "camera": "push-in",
        "atmosphere": {
          "tint": "#0e2a33",
          "dim": 0.35
        }
      }
    },
    {
      "text": "साथी नीरज ने पूछा, लोगों को बताया? आरव बोला, चेतावनी आधिकारिक चैनल से जाएगी। मैं घर तैयार करूँगा।",
      "transition": "fade",
      "visual": {
        "prompt": "Aarav and his colleague face each other in the control room.",
        "file": null,
        "source": "react-art",
        "art": {
          "location": "office",
          "characters": [
            {
              "id": "AARAV",
              "mood": "resolute",
